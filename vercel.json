
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/_proxy/:host/:path*",
      "destination": "/api/jellycade?__host=:host&__path=/:path*"
    },
    {
      "source": "/_proxy/:host",
      "destination": "/api/jellycade?__host=:host&__path=/"
    },
    {
      "source": "/",
      "destination": "/api/jellycade?__path=/"
    },
    {
      "source": "/:path((?!api/jellycade).*)",
      "destination": "/api/jellycade?__path=/:path"
    }
  ]
}
